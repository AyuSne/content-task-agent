  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」制作一条60秒竖屏短视频，面向25-40岁旅行爱好者，演示「自动卡点→逐段微调」并用普通话口播生成可编辑字幕，作为周末旅行记录剪辑教程的主题内容，交给运营继续制作。",
      "audience": "25-40岁成年旅行爱好者（任务输入已确认受众）。资料中的校园调研（M-003）样本为18-24岁大学生，仅作背景，不外推为该受众事实；因此本方案不引用其任何用户数据。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐节拍，把用户选中的视频片段对齐到节拍点；支持逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本第2-3段：卡点演示与微调演示的核心产品主张"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上，作用范围限定；作为能力边界表述",
          "use": "主脚本口播/字幕的诚实边界说明，也用于选曲（清晰鼓点）的依据"
        },
        {
          "claim": "帧剪的AI字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语；普通话与英语为正式支持语言。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。普通话与英语为正式支持语言；",
          "scope": "正式支持普通话与英语识别；粤语、日语等为实验性、不计入对外承诺",
          "use": "主脚本第4段：普通话口播生成可编辑字幕的演示依据"
        },
        {
          "claim": "粤语、日语等其他语言仍在小范围测试，识别质量不稳定，不作为本次卖点。",
          "material_id": "M-002",
          "quote": "粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "实验性能力，不得写成正式能力",
          "use": "脚本不出现多语言字幕卖点的依据说明"
        },
        {
          "claim": "品牌表达应轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；",
          "scope": "适用于所有对外传播",
          "use": "全片文案、字幕与素材说明的合规基线"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；缺画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "平台与发布排期可提建议，不属于关键阻塞。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条60秒竖屏主视频，演示自动卡点后微调，再为普通话口播制作可编辑字幕。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "不把大学生合成调研外推为该受众（25-40岁旅行爱好者）事实。",
          "source": "用户输入 requirements[2]；M-003 适用范围仅限18-24岁大学生合成样本"
        },
        {
          "text": "旅行画面由制作人员后续自行拍摄并核对权属。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "品牌禁语：不得承诺涨粉、收益、爆款；不得绝对化表述；实验性功能不写成正式能力。",
          "source": "M-004"
        }
      ],
      "assumptions": [
        {
          "text": "主视频时长60秒，与自动卡点支持的60秒成片档位一致，无需拼接多档。",
          "basis": "M-001 支持15/30/60秒成片；用户要求60秒"
        },
        {
          "text": "配乐选用节奏清晰、约120BPM的曲目，以保证卡点演示稳定。",
          "basis": "M-001 说明对节奏清晰的流行乐与鼓点识别更稳；M-006《Late Bus》120BPM，但授权未购"
        },
        {
          "text": "成片比例按竖屏9:16发布（短视频平台通用），具体平台待建议确定。",
          "basis": "用户要求竖屏；无资料规定导出比例，属创作建议"
        },
        {
          "text": "运营团队可安排人员自行拍摄周末旅行画面。",
          "basis": "用户 requirements[2] 明确旅行画面由制作人员后续拍摄"
        }
      ],
      "suggestions": [
        {
          "text": "创作方向建议采用教程型（周末旅行记录剪辑三步：卡点、微调、字幕），而非纯功能演示或纯情境片。",
          "basis": "任务主题为“剪辑教程”，且两者都要演示；教程结构能在60秒内容纳两个能力点并给出可操作步骤"
        },
        {
          "text": "发布建议：以抖音/视频号/小红书等竖屏平台为主，周末前一天（如周五）发布更贴合“周末旅行记录”使用情境。",
          "basis": "创作建议，非资料事实；平台与排期允许建议，不构成关键阻塞"
        },
        {
          "text": "配乐优先使用原创鼓点或已购授权曲目；若《Late Bus》授权按期获批再替换，避免版权风险。",
          "basis": "M-006 商用授权尚未购买，仅可试听；M-001 要求节奏清晰"
        },
        {
          "text": "字幕段只演示普通话识别与批量改样式，不涉及翻译或其他语言。",
          "basis": "M-002 正式支持语言范围；M-004 禁止把实验性功能写成正式能力"
        }
      ],
      "unknowns": [
        {
          "question": "本次活动的真实投放预算与采购费用（音乐授权、拍摄成本）未提供；任务 budget_cents=2000 仅为本方案准备的模拟工具费用上限。",
          "impact": "方案只能写“待估”，不以任务预算承诺购买M-006授权；不影响内容方案可制作性。",
          "blocking": false
        },
        {
          "question": "《Late Bus》商用授权能否在2个工作日内取得（M-006 记录预计2个工作日）。",
          "impact": "若未获批则改用原创鼓点或替代已授权曲目；已在素材表写明替换与发布前处置。",
          "blocking": false
        },
        {
          "question": "旅行实拍画面拍摄人员的具体身份与拍摄档期。",
          "impact": "影响制作排期，但不影响方案内容结构；以责任角色+发布日倒排锚点安排。",
          "blocking": false
        }
      ],
