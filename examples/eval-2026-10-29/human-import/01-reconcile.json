  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一条 15 秒竖屏短视频的内容活动方案，向 18-24 岁大学生介绍社团招新场景下的自动对齐节拍与逐段手动微调能力，结尾邀请按需尝试，供运营继续制作。",
      "audience": "18-24 岁大学生（用户已确认）。依据 M-003 合成调研：该样本最常制作社团活动记录等类型，过半在 30 分钟内完成一条成片，模板与自动卡点能减少重复操作，且对「一键出片」信任度一般、更愿意保留手动调整——因此内容要同时呈现「自动对齐节拍」的效率与「逐段微调」的可控性。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本核心卖点：社团招新片段按音乐节拍切换"
        },
        {
          "claim": "用户可以逐段微调，也可以一键重新卡点。",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上",
          "use": "主脚本第二卖点：展示手动微调某一段的起止点，回应受众更愿保留手动调整的偏好"
        },
        {
          "claim": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "适用全部曲风；复杂变速/弱节拍需人工调整",
          "use": "用于限定表达口径：不写「任何音乐都能精准卡点」，脚本用节奏清晰的 120 BPM 曲目并保留微调动作"
        },
        {
          "claim": "对外表达须轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用「最强」「唯一」等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播",
          "use": "约束文案与结尾行动号召，只做「按需尝试」邀请"
        }
      ],
      "creative_requirements": [
        {
          "text": "仅一条 15 秒竖屏主视频，突出自动对齐节拍和逐段手动微调，结尾邀请按需尝试。",
          "source": "用户输入 requirements"
        },
        {
          "text": "产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements；M-004 品牌规则"
        },
        {
          "text": "缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、使用位置和权属核对；不可冒充现成素材。",
          "source": "用户输入 requirements"
        },
        {
          "text": "平台和发布排期可以提出建议，不作为关键阻塞。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不使用「最强」「唯一」等绝对化表述；不把实验性功能写成正式能力。",
          "source": "M-004"
        }
      ],
      "assumptions": [
        {
          "text": "主视频按 15 秒成片设计，落在 M-001 支持的 15/30/60 秒规格内，无需额外裁剪。",
          "basis": "M-001 支持 15 秒成片；用户要求 15 秒"
        },
        {
          "text": "演示曲目采用节奏清晰的 120 BPM 流行乐，属于 M-001 识别更稳的范围。",
          "basis": "M-006 曲目为 120 BPM；M-001 对节奏清晰的流行乐与鼓点识别更稳"
        },
        {
          "text": "目标观众用手机竖屏、静音环境刷到本视频，主要靠字幕与画面动作理解，因此需要全程关键字幕。",
          "basis": "竖屏短视频常见观看习惯为合理推断，非已确认数据"
        }
      ],
      "suggestions": [
        {
          "text": "结构采用 3 段式：0-4 秒招新片段冲突+字幕点出「卡不上拍」，4-11 秒自动卡点→逐段微调的操作特写，11-15 秒成片回放+结尾邀请按需尝试。",
          "basis": "受众偏好保留手动调整（M-003），把微调放在可见画面里比只讲效率更顺"
        },
        {
          "text": "结尾只用「社团招新要发视频？需要时去帧剪里试试自动卡点」这类按需邀请，不写「一键出片」「保证上热门」。",
          "basis": "M-004 禁止爆款/收益承诺与绝对化表述；M-003 显示对一键出片信任度一般"
        },
        {
          "text": "平台建议为抖音 + 视频号竖屏冷启动，主视频发布节点建议在方案核实后第 3 个工作日，与社团招新季内容期一致。",
          "basis": "用户允许建议平台与排期；具体发布日期真实锚点由运营确认"
        },
        {
          "text": "操作录屏由剪辑执行人同一天完成录制并在第 2 个工作日复核，避免脚本演示与实际界面不一致。",
          "basis": "M-001 的 4.2 版本能力需与录屏界面版本对应"
        }
      ],
      "unknowns": [
        {
          "question": "发布平台与具体发布日期由谁最终确认？",
          "impact": "影响投放节奏与制作排期，但不影响脚本与素材可行性",
          "blocking": false
        },
        {
          "question": "成片制作、配乐采购、投放的真实费用预算尚未给出。",
          "impact": "任务预算 2000 分仅为本次方案准备的模拟工具费用，不能用于承诺音乐采购或投放；需单列待估",
          "blocking": false
        },
        {
          "question": "M-006 背景音乐《Late Bus》商用授权预计 2 个工作日，是否能在发布前取得？",
          "impact": "未取得则须替换为有授权的原创鼓点或曲目，影响第 2-3 段音乐节奏与卡点效果",
          "blocking": false
        }
      ],
