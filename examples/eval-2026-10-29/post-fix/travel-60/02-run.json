  "brief": {
    "version": 1,
    "content": {
      "goal": "为 25-40 岁成年旅行爱好者准备一条 60 秒竖屏短视频推广活动方案，演示帧剪「自动卡点后逐段微调」与「为普通话口播生成可编辑字幕」，交付运营继续制作。",
      "audience": "25-40 岁成年旅行爱好者（用户输入已确认）。不使用 M-003 的 18-24 岁大学生样本外推该受众偏好。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐节拍，把用户选中的视频片段对齐到节拍点；支持逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主脚本第 1-2 段演示自动卡点与随后逐段微调的功能依据"
        },
        {
          "claim": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整；对节奏清晰的流行乐与鼓点识别更稳。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上；作为能力边界，须在方案与成片中体现",
          "use": "脚本台词与待确认项中说明边界，避免绝对化表述；也用于解释为何需要微调环节"
        },
        {
          "claim": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语；普通话与英语为正式支持语言。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "普通话与英语为正式支持；其他语言为实验性，不做对外承诺",
          "use": "主脚本第 3 段普通话口播字幕演示的功能依据；其他语言不作为卖点"
        },
        {
          "claim": "对外表达应轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播",
          "use": "贯穿方案与脚本的语气、卖点与字幕措辞约束"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements[0] / M-004"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "平台和发布排期可以提出建议，不必把可建议项当成关键阻塞。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条 60 秒竖屏主视频，演示自动卡点后微调，再为普通话口播制作可编辑字幕。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "不把大学生合成调研外推为该受众事实；旅行画面由制作人员后续自行拍摄并核对权属。",
          "source": "用户输入 requirements[2]"
        }
      ],
      "assumptions": [
        {
          "text": "主视频交付为 60 秒竖屏（9:16），与任务输入的时长和方向一致。",
          "basis": "用户输入 requirements[2]；M-001 支持 60 秒成片"
        },
        {
          "text": "成片采用普通话口播旁白，因此字幕演示段落使用正式支持的普通话识别。",
          "basis": "用户输入“为普通话口播制作可编辑字幕”；M-002 普通话为正式支持语言"
        },
        {
          "text": "主视频为本活动的核心单一内容，其余切片与投放节奏只作建议性安排，不为填满素材目录而增加卖点。",
          "basis": "聚焦范围要求内容安排服务已确认目标"
        }
      ],
      "suggestions": [
        {
          "text": "建议平台以抖音为主、小红书同步发布竖屏版本；排期建议放在方案核实保存之后的制作完成节点。",
          "basis": "25-40 岁旅行爱好者常用的短视频消费场景；用户已明确平台可建议、非阻塞"
        },
        {
          "text": "结构建议：0-15 秒旅行片段随节拍快切（自动卡点）→15-40 秒逐段微调特写与效果对比→40-60 秒普通话口播配上可编辑字幕并展示样式修改。",
          "basis": "任务要求的三段演示顺序；M-001、M-002 的能力范围"
        },
        {
          "text": "音乐优先申请《Late Bus》（120 BPM，节奏清晰）用于卡点演示，授权到位前不写入“已可用”。",
          "basis": "M-006 状态为待获取授权、预计 2 个工作日；M-001 说明节奏清晰的曲目识别更稳"
        },
        {
          "text": "为避免误导，字幕段落只演示普通话识别与可编辑修改，不出现多语言识别或翻译成片头卖点。",
          "basis": "M-002 其他语言为实验性；M-004 禁止把实验性功能写成正式能力"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》商用授权能否在发布前取得；若未取得，改用已授权曲目的方案。",
          "impact": "影响卡点段落所用的音乐与发布时点；不阻塞方案准备，可在发布前处置",
          "blocking": false
        },
        {
          "question": "音乐采购、旅行实拍与录屏制作、平台投放的真实费用未给出。",
          "impact": "无法给出活动总成本；任务预算仅为方案准备的模拟工具费用上限，不作为采购或投放预算",
          "blocking": false
