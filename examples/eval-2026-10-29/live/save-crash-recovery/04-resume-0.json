  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一条 30 秒学习打卡主题短视频的推广活动方案，用可继续制作的安排向 18-24 岁大学生演示自动卡点（自动对齐节拍）与逐段微调，不做涨粉、收益或爆款承诺。",
      "audience": "18-24 岁大学生（任务指定）。依据 M-003 合成调研（样本 120 人）：该群体最常做社团活动记录、学习打卡和旅行 vlog；多数在 30 分钟内完成一条成片；认为模板与自动卡点能减少重复操作，但对“一键出片”信任度一般、更愿保留手动调整——因此内容应展示“自动卡点 + 自己逐段微调”而非全自动。该样本仅代表合成样本，不可外推为全体大学生。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 帧剪 4.2 及以上版本",
          "use": "主视频第 2 段：演示学习打卡片段按音乐节拍自动生成切点"
        },
        {
          "claim": "自动卡点结果可以逐段微调，也可以一键重新卡点",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 帧剪 4.2 及以上版本",
          "use": "主视频第 3 段：演示对单段切点手动前后移动后再回看"
        },
        {
          "claim": "自动卡点支持 15/30/60 秒成片，对节奏清晰的流行乐与鼓点识别更稳",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍",
          "scope": "功能说明 v4.2 标注：iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳（该范围写在材料适用范围字段）",
          "use": "方案说明 30 秒成片属于正式支持范围；制作时选用鼓点清晰的配乐"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "全曲风；弱节拍/变速音乐",
          "use": "主视频第 4 段字幕如实提示适用范围，避免绝对化效果暗示"
        }
      ],
      "creative_requirements": [
        {
          "text": "产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对；不可冒充现成素材",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "平台和发布排期可以提建议，不当作关键阻塞",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条 30 秒主视频，演示自动对齐节拍和逐段微调",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "表达轻快、真实、可操作；不得使用“最强”“唯一”等绝对化表述；不得把实验性功能写成正式能力",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "主视频采用竖屏 9:16 短视频形态，适合手机端观看剪辑演示",
          "basis": "任务为短视频推广，受众为手机端大学生（M-003）"
        },
        {
          "text": "发布平台以抖音为主、小红书为备选，仅作为建议不构成阻塞",
          "basis": "M-003 调研对象常用短视频平台习惯；具体平台未在任务输入中指定，故列为建议"
        },
        {
          "text": "成片中的学习打卡情境画面使用 M-005 校园素材包的教室、操场、宿舍剪辑场景",
          "basis": "M-005 已取得演员授权、限本题活动使用、1080p 10-20 秒片段"
        },
        {
          "text": "配乐优先使用原创制作的清晰鼓点音乐；若 M-006 授权取得，可作为替换方案",
          "basis": "M-006 商用授权尚未购买不可直接发布；M-001 指出鼓点清晰时识别更稳"
        }
      ],
      "suggestions": [
        {
          "text": "主脚本以“自动卡点→逐段微调→回看效果”为三段主线，把微调作为卖点之一而非隐藏步骤",
          "basis": "M-003 显示用户对一键出片信任度一般、更愿保留手动调整"
        },
        {
          "text": "全片时长控制在 30 秒，与自动卡点正式支持的 30 秒成片规格一致",
          "basis": "M-001 支持 15/30/60 秒成片"
        },
        {
          "text": "节奏用“约 3 秒钩子 + 约 20 秒演示 + 约 7 秒提示与收尾”的结构",
          "basis": "M-004 表达应轻快、真实、可操作"
        },
        {
          "text": "发布节点建议为方案保存并制作完成后 3 个工作日内的课间时段（如工作日晚 19:00-21:00），制作完成前不预告具体日期",
          "basis": "任务输入仅约束方案截止 2026-10-30T04:00Z，成片制作与发布需另排期"
        }
      ],
