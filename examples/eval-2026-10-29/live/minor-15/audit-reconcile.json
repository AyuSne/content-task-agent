  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一份面向高中生的校园生活记录短视频推广方案：用一条 15 秒主视频只讲清“自动卡点 + 逐段微调”这一正式能力，交付运营可直接继续制作的内容活动方案，不作涨粉、收益或爆款承诺。",
      "audience": "15-17 岁高中生（运营已明确指定）。资料中没有高中生专属调研数据，M-003 为 18-24 岁大学生样本，仅可作创作参考，不得作为高中生行为数据或受众依据引用。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 帧剪 4.2 及以上版本；支持 15/30/60 秒成片",
          "use": "主视频核心卖点，第 1-2 段画面与字幕表达的基础"
        },
        {
          "claim": "卡点结果支持逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "同上；适用于已生成卡点结果之后的调整环节",
          "use": "主视频第 3 段“微调”演示与字幕依据"
        },
        {
          "claim": "自动卡点对节奏清晰的流行乐与鼓点识别更稳，但不承诺对所有曲风都准确。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "节奏清晰的流行乐与鼓点更稳；复杂变速或弱节拍音乐需人工调整",
          "use": "脚本选曲说明与待确认项中的曲风风险提示，避免绝对化承诺"
        },
        {
          "claim": "对外表达须轻快、真实、可操作，不得承诺涨粉、收益或爆款，不得把实验性功能写成正式能力，不得使用“最强”“唯一”等绝对化表述，涉及未成年人时避免诱导消费。",
          "material_id": "M-004",
          "quote": "不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "约束全方案文案、字幕与行动号召，不出现诱导充值或购买引导"
        }
      ],
      "creative_requirements": [
        {
          "text": "只介绍自动卡点与微调，一条 15 秒主视频",
          "source": "用户输入 requirements"
        },
        {
          "text": "不引导购买、充值或诱导消费",
          "source": "用户输入 requirements"
        },
        {
          "text": "不把 M-003 的大学生样本外推为高中生数据；学生画面另行制作并核对肖像和使用授权",
          "source": "用户输入 requirements"
        },
        {
          "text": "允许把缺少的画面、操作录屏和原创配乐列为待制作，写清责任人、位置和权属核对，不可冒充现成素材",
          "source": "用户输入 requirements"
        },
        {
          "text": "平台和发布排期可提出建议，不视为关键阻塞",
          "source": "用户输入 requirements"
        },
        {
          "text": "产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺",
          "source": "用户输入 + M-004"
        }
      ],
      "assumptions": [
        {
          "text": "主视频面向抖音/视频号等竖屏短视频平台，9:16 竖屏",
          "basis": "用户未指定平台，属可建议项；高中生短视频消费与校园内容常见于竖屏平台"
        },
        {
          "text": "主视频使用 30 秒成片规格以内的 15 秒时长，符合 M-001 所述 15 秒成片支持范围",
          "basis": "M-001 支持 15/30/60 秒成片，用户要求 15 秒"
        },
        {
          "text": "配套需一段节奏清晰、120 BPM 左右配乐以便节拍演示",
          "basis": "M-001 说明节拍清晰音乐识别更稳；M-006《Late Bus》为 120 BPM 但商用授权未购买"
        }
      ],
      "suggestions": [
        {
          "text": "采用 15 秒单条主视频 + 可选 1 条 8-10 秒花絮切片的轻量内容安排，避免为填目录增加内容",
          "basis": "已确认目标仅需讲清一个能力，一条内容即可构成完整方案；额外切片仅在运营有余力时补充"
        },
        {
          "text": "主脚本用“社团招新画面跟着鼓点切换 → 手动拖动一段对齐”的真实操作情境承载演示，情境画面只表场景，能力由操作录屏与 M-001 支撑",
          "basis": "M-005 为情境画面，不能单独证明功能；M-001 支持卡点与微调能力"
        },
        {
          "text": "配乐优先使用运营自制原创鼓点循环，M-006《Late Bus》作为备选，需先完成商用授权",
          "basis": "M-006 授权未购买不可直接发布；原创配乐权属自有、可控"
        },
        {
          "text": "建议发布节点为方案确认后 D+3（制作 D-3 至 D-1 完成录屏与审核），与方案截止 2026-10-30 04:00 分开排期",
          "basis": "方案截止仅约束方案准备与保存，成片制作需另设锚点；用户允许建议排期"
        }
      ],
