  "brief": {
    "version": 1,
    "content": {
      "goal": "为帧剪「校园社团招新」主题准备一份可继续制作的内容活动方案，含一条 30 秒主视频，围绕自动卡点展示真实、可操作的剪辑方式，不作涨粉承诺。",
      "audience": "18-24 岁大学生，尤其是需要为社团招新制作活动记录短片的学生（用户输入已确认）。M-003 合成调研显示该样本常做社团活动记录、学习打卡、旅行 vlog，过半在 30 分钟内完成成片，认为模板与自动卡点能减少重复操作，但更愿保留手动调整；仅代表该合成样本，不外推全体大学生。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐节拍，把用户选中的视频片段对齐到节拍点，支持逐段微调和一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主脚本核心演示点与对外表达依据"
        },
        {
          "claim": "自动卡点不保证所有曲风都准确，复杂变速或弱节拍音乐需人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同 M-001 适用范围",
          "use": "脚本中标注局限，避免绝对化承诺"
        },
        {
          "claim": "AI 字幕当前正式支持普通话与英语识别，可批量改样式、一键翻译为英语；粤语、日语等仍在测试。",
          "material_id": "M-002",
          "quote": "普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "产品功能说明 v4.2，其他语言为实验性",
          "use": "如主脚本需要字幕，作为可选辅助说明；不作主卖点"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条 30 秒主视频的完整内容活动方案",
          "source": "用户输入 requirements 第 1 条"
        },
        {
          "text": "只使用合成资料可支持的正式能力",
          "source": "用户输入 requirements 第 2 条"
        },
        {
          "text": "说明音乐授权和待制作操作录屏",
          "source": "用户输入 requirements 第 2 条"
        },
        {
          "text": "不作涨粉承诺",
          "source": "用户输入 requirements 第 2 条 + M-004 品牌表达规则"
        },
        {
          "text": "比较包含一次必要返修及复核预留的完整路径，再依据实际预算反馈选择模式；预留不计已发生费用，不要求用尽预算",
          "source": "用户输入 requirements 第 3 条"
        },
        {
          "text": "表达轻快、真实、可操作；禁用绝对化表述，不得把实验性功能写成正式能力",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "不得超过 600 美分模拟工具预算，方案准备与保存须在 2026-10-30T04:00:00+00:00 前完成",
          "source": "用户输入 budget_cents / deadline"
        }
      ],
      "assumptions": [
        {
          "text": "音乐选用 M-006 节奏清晰的 120 BPM《Late Bus》，契合自动卡点适用范围中识别更稳的节奏类型",
          "basis": "M-006 曲目信息与 M-001 适用范围中“对节奏清晰的流行乐与鼓点识别更稳”"
        },
        {
          "text": "成片为 30 秒（M-001 支持的时长档位之一）",
          "basis": "用户要求 30 秒主视频 + M-001 支持 15/30/60 秒成片"
        },
        {
          "text": "发布平台以短视频平台（竖屏 9:16）为主要假设，未指定时按校园受众常用平台处理",
          "basis": "受众为 18-24 岁大学生，平台未在输入中指定"
        },
        {
          "text": "操作录屏为待制作素材，需实际使用帧剪 4.2 录制自动卡点与逐段微调过程",
          "basis": "资料目录无现成录屏素材"
        }
      ],
      "suggestions": [
        {
          "text": "采用用户情境 + 轻教程结构：以社团招新场景开场，再展示自动卡点与手动微调，比纯功能演示更贴合大学生观看习惯",
          "basis": "M-003 显示用户更愿保留手动调整、对“一键出片”信任度一般"
        },
        {
          "text": "脚本中明确一句“复杂变速或弱节拍需要手动调整”，增强可信度",
          "basis": "M-001 局限说明 + M-004 真实、可操作要求"
        },
        {
          "text": "以 M-005 校园素材包的社团招新、教室、操场片段作为情境画面，产品能力另由录屏证明",
          "basis": "M-005 明确情境画面不能单独证明功能"
        },
        {
          "text": "音乐授权未购买前，先以试听版做粗剪时间线，授权取得后替换为正式文件",
          "basis": "M-006 授权状态为待获取，预计 2 个工作日"
        },
        {
          "text": "选曲优先节奏清晰的流行乐或鼓点明显的曲目，避免复杂变速与弱节拍",
          "basis": "M-001 适用范围注明“对节奏清晰的流行乐与鼓点识别更稳”，选曲应避开复杂变速曲目"
        }
      ],
      "unknowns": [
        {
          "question": "音乐《Late Bus》商用授权何时能拿到？预算 600 美分仅为方案准备模拟工具费用，不包含音乐采购费用。",
