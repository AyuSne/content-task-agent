  "brief": {
    "version": 1,
    "content": {
      "goal": "围绕「自动卡点」为帧剪准备一份含一条 30 秒主视频的校园社团招新短视频推广活动方案，供后续拍摄、剪辑与发布执行，并在 2026-10-30T04:00Z 前完成方案准备与核实保存。",
      "audience": "18-24 岁大学生（用户指定）。M-003 合成调研样本（120 名 18-24 岁大学生）显示：最常制作社团活动记录、学习打卡、旅行 vlog；超过一半会在 30 分钟内完成一条成片；模板与自动卡点能明显减少重复操作；对「一键出片」信任度一般，更愿意保留手动调整。据此建议主视频以社团招新记录为场景，强调可逐段微调而非一键出片。该调研仅代表该合成样本，不外推为全体大学生。",
      "product_facts": [
        {
          "claim": "帧剪自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点；用户可逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；对节奏清晰的流行乐与鼓点识别更稳。支持 15/30/60 秒成片（见资料范围字段）。",
          "use": "主视频核心卖点与字幕表述，第 2-4 段卡点演示的事实依据。"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上（iOS/Android 4.2 及以上）。",
          "use": "脚本中如实呈现「可逐段微调」的限制说明，避免绝对化承诺。"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条 30 秒主视频的完整内容活动方案。",
          "source": "用户输入 requirements"
        },
        {
          "text": "只使用合成资料可支持的正式能力；说明音乐授权和待制作操作录屏；不作涨粉承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "比较包含一次必要返修及复核预留的完整路径，再依据实际预算反馈选择模式；预留不计已发生费用，不要求用尽预算。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用「最强」「唯一」等绝对化表述。",
          "source": "资料 M-004 品牌表达规则"
        },
        {
          "text": "音乐《Late Bus》商用授权尚未购买，仅可试听，未取得授权前不得写成已可用。",
          "source": "资料 M-006"
        }
      ],
      "assumptions": [
        {
          "text": "活动主阵地假设为抖音/视频号等竖屏短视频平台，主视频为 9:16 竖屏。",
          "basis": "任务未指定平台；M-003 调研对象为以短视频记录校园活动的大学生，竖屏短视频为常见形式。"
        },
        {
          "text": "主视频结构采用「社团招新记录 + 卡点前后对比 + 可逐段微调」的功能演示，时长 30 秒。",
          "basis": "M-001 支持 30 秒成片与自动卡点；M-003 显示社团活动记录是高频类型且受众重视手动调整。"
        }
      ],
      "suggestions": [
        {
          "text": "主视频之外不额外增设切片或字幕翻译等卖点，一条主视频即构成完整活动方案，避免引入无资料支持的能力与额外制作依赖。",
          "basis": "任务只要求一条 30 秒主视频；M-001 未覆盖字幕翻译等能力。"
        },
        {
          "text": "卡点演示选用 120 BPM、节奏清晰的《Late Bus》，并在授权取得后再交片；备选节奏清晰流行乐作为兜底。",
          "basis": "M-006 记录该曲 120 BPM 适合卡点演示但授权待获取；M-001 说明节奏清晰的流行乐识别更稳。"
        },
        {
          "text": "脚本中明确「可逐段微调」并保留一处人工微调镜头，回应受众对「一键出片」信任度一般、愿意手动调整的偏好。",
          "basis": "M-003 调研结论。"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》商用授权采购费用、授权范围以及活动真实制作/投放费用未给出。",
          "impact": "音乐采购与投放预算无法编入方案；不阻塞方案制作，但需在发布前确认授权并另行估算真实费用。",
          "blocking": false
        },
        {
          "question": "操作录屏由谁录制、使用哪台设备与系统版本，尚未指定。",
          "impact": "影响录屏制作负责人与时间点安排；方案中写作待制作并给出角色与节点，不阻塞。",
          "blocking": false
        },
        {
          "question": "计划发布平台与账号是否已确定。",
          "impact": "影响投放节奏与账号授权；方案按竖屏短视频平台假设给出建议排期。",
          "blocking": false
