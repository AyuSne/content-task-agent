  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一份以自动卡点为核心的校园社团招新短视频推广活动方案，含一条30秒主视频，可继续进入制作。",
      "audience": "18-24岁大学生（用户已确认）。建议聚焦需要在社团招新季快速产出活动记录短视频的大学生社团成员：合成调研显示受访者最常制作社团活动记录，超过一半会在30分钟内完成一条成片，且更愿意保留手动调整（M-003，仅代表该120人合成样本，不可外推至全体大学生）。",
      "product_facts": [
        {
          "claim": "帧剪自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点，并支持逐段微调与一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本卡点演示段落的核心能力表达与字幕依据"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上，全部曲风范围",
          "use": "脚本中如实保留微调环节，避免绝对化表述；作为创作约束"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条30秒主视频的完整内容活动方案",
          "source": "用户输入"
        },
        {
          "text": "只使用合成资料可支持的正式能力；说明音乐授权和待制作操作录屏；不作涨粉承诺",
          "source": "用户输入"
        },
        {
          "text": "比较包含一次必要返修及复核预留的完整路径，再依据实际预算反馈选择模式；预留不计已发生费用，不要求用尽预算",
          "source": "用户输入"
        },
        {
          "text": "表达轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "校园场景素材为情境画面，只能说明使用场景，不能单独证明产品功能",
          "source": "M-005 素材登记"
        }
      ],
      "assumptions": [
        {
          "text": "活动主阵地假设为抖音/视频号等竖屏短视频平台，按 9:16 竖版 30 秒设计",
          "basis": "用户未限定平台；M-001 支持 30 秒成片，M-003 样本群体为短视频创作者"
        },
        {
          "text": "主视频使用 M-006《Late Bus》（120 BPM）作为卡点音乐，前提是商用授权在发布前取得",
          "basis": "M-006 标注节奏适合卡点演示，但当前仅可试听"
        }
      ],
      "suggestions": [
        {
          "text": "脚本保留“自动卡点后逐段微调”的一步，而非宣称一键完美出片",
          "basis": "M-001 说明需人工调整；M-003 受访者对‘一键出片’信任度一般、更愿保留手动调整"
        },
        {
          "text": "以社团招新现场片段（M-005 招新场景）作为情境画面，操作录屏单独承担功能展示",
          "basis": "M-005 明确情境画面不能单独证明功能，功能需由录屏/证据承担"
        },
        {
          "text": "活动以一条30秒主视频为核心交付，暂不追加切片与额外卖点",
          "basis": "知识聚焦范围：不因资料目录增加内容；用户仅要求一条主视频"
        }
      ],
      "unknowns": [
        {
          "question": "音乐采购、录屏制作与投放费用未提供，需单列为待估",
          "impact": "不影响方案结构与主脚本；影响制作排期与上线条件的成本评估",
          "blocking": false
        },
        {
          "question": "成片制作与发布的具体日期未给出，方案截止只约束方案准备与保存",
          "impact": "发布节点需以明确锚点给出建议排期",
          "blocking": false
        },
        {
          "question": "M-006《Late Bus》商用授权是否能在发布前取得",
          "impact": "若未取得需替换为已授权音乐，影响第2、3段卡点节拍匹配",
          "blocking": false
        }
      ],
