  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一份以自动卡点为核心的校园社团招新短视频推广活动方案，含一条30秒主视频，供后续制作与发布使用。",
      "audience": "18-24岁大学生（用户已确认）；结合合成调研，其中校园社团活动的组织者与参与者、需要在30分钟内产出社团招新短片的学生为主要触达对象。依据 M-003：受访者最常制作的类型是社团活动记录；超过一半受访者表示会在30分钟内完成一条成片，模板和自动卡点能明显减少重复操作，且更愿意保留手动调整。",
      "product_facts": [
        {
          "claim": "帧剪自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点，并支持逐段微调与一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本核心卖点与第2-3段的字幕/口播表达；30秒成片能力与本次主视频时长对齐"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上；作为功能边界，对外须知",
          "use": "脚本与发布文案中的边界说明，避免绝对化承诺；指导选用节奏清晰的曲子"
        },
        {
          "claim": "帧剪 AI 字幕正式支持普通话与英语，其他语言为实验性。",
          "material_id": "M-002",
          "quote": "普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "当前正式支持普通话与英语识别；其他语言为实验性，不计入对外承诺",
          "use": "仅在需要出字幕时作为辅助说明；本轮不作主卖点"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条30秒主视频的完整内容活动方案。",
          "source": "用户输入 requirements"
        },
        {
          "text": "只使用合成资料可支持的正式能力；说明音乐授权和待制作操作录屏；不作涨粉承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "表达应轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述。",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "竞品模板数量、其他外部自述不得用于证明帧剪能力或作比较依据。",
          "source": "M-007"
        }
      ],
      "assumptions": [
        {
          "text": "发布平台以学生常用的短视频平台为主，如抖音/小红书/B站，具体排期由运营确认。",
          "basis": "用户未指定平台；受众为18-24岁大学生，M-003 未覆盖平台偏好，故仅作建议性假设，不写入硬约束"
        },
        {
          "text": "主视频由社团招新相关情境画面加操作录屏构成，情境画面用 M-005 素材，能力演示用待制作录屏。",
          "basis": "M-005 明确情境画面只能说明使用场景、不能单独证明功能；M-001 的能力需以录屏或界面演示呈现"
        },
        {
          "text": "音乐采购、录屏制作与投放费用未给出，不计入本次方案预算。",
          "basis": "任务 budget_cents=2000 为方案准备的模拟工具费用上限，真实活动费用未知"
        }
      ],
      "suggestions": [
        {
          "text": "选用节奏清晰的 120 BPM 曲目《Late Bus》做卡点演示，与其节拍特征匹配。",
          "basis": "M-006 记载 120 BPM、适合卡点演示；M-001 说明节奏清晰的流行乐与鼓点识别更稳"
        },
        {
          "text": "避开“一键出片”“最准”等表述，改为“自动对齐节拍，可逐段微调”，以贴合学生更愿保留手动调整的偏好。",
          "basis": "M-003 显示对“一键出片”的信任度一般、更愿保留手动调整；M-004 禁止绝对化表述"
        },
        {
          "text": "主视频结构建议：0-6秒社团招新情境钩子，6-20秒自动卡点操作演示，20-27秒逐段微调效果对比，27-30秒落版与使用入口提示。",
          "basis": "M-001 支持逐段微调演示；M-005 提供招新情境画面；符合30秒时长要求"
        },
        {
          "text": "同一主视频可复用为社团招新场景的二次剪辑版本（换标题与文案），不新增功能卖点。",
          "basis": "不增加制作依赖，服务校园社团招新目标；不需要新素材"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》商用授权能否在发布前购得（预计2个工作日，而当前截止为2026-10-30 04:00 UTC）？",
          "impact": "若未取得授权，主视频第2-3段音乐需替换为已获授权的节奏清晰曲目，卡点演示片段需重剪；不影响方案本身成立，但影响发布节点。",
          "blocking": false
        },
        {
          "question": "操作录屏由谁在什么设备上录制？",
          "impact": "决定录屏可用时间与画面分辨率一致性；已按“运营在发布日前完成”写入制作步骤，作为可继续制作方案的一部分。",
          "blocking": false
        },
        {
          "question": "发布平台与账号归属（学校社团账号还是帧剪官方号）？",
          "impact": "影响文案口吻、落版引导与排期；不改变主视频内容与时长。",
          "blocking": false
        }
      ],
