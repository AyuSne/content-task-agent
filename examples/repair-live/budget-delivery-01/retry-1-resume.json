  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一份面向 18-24 岁大学生的校园社团招新短视频推广活动方案，以自动卡点为核心卖点，含一条 30 秒主视频，方案可在截止前核实保存并继续制作。",
      "audience": "18-24 岁大学生（用户已确认）。据 M-003 合成调研，该年龄段受访者最常制作社团活动记录、学习打卡与旅行 vlog，过半会在 30 分钟内完成成片，认为模板和自动卡点能明显减少重复操作，但更愿意保留手动调整、对「一键出片」信任度一般——因此内容以「快速对齐节拍 + 逐段微调」为表达重点。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把选中片段自动对齐到节拍点；用户可逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 帧剪 4.2 及以上版本",
          "use": "主脚本核心演示段落，以及活动主题的唯一主卖点"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "iOS/Android 帧剪 4.2 及以上；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "脚本结尾免责字幕与选曲说明，避免绝对化承诺"
        },
        {
          "claim": "校园场景素材包已取得演员授权，含教室、操场、社团招新、宿舍剪辑共 12 条 10-20 秒 1080p 片段。",
          "material_id": "M-005",
          "quote": "素材包含教室、操场、社团招新、宿舍剪辑四个场景，共 12 条 10-20 秒片段，分辨率 1080p。",
          "scope": "已取得演员授权，限本题活动使用；不含品牌 Logo 特写；情境画面不能单独证明产品功能",
          "use": "主视频情境画面来源"
        },
        {
          "claim": "背景音乐《Late Bus》为 120 BPM，节奏适合卡点演示，但商用授权尚未购买。",
          "material_id": "M-006",
          "quote": "曲目节奏为 120 BPM，适合卡点演示。当前状态为待获取授权，预计 2 个工作日",
          "scope": "仅可试听，不可直接用于发布；商用授权未购买",
          "use": "作为候选配乐写入素材表（状态：待获取），授权到手前不得视为已可用"
        },
        {
          "claim": "品牌要求表达轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用「最强」「唯一」等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "全案文案与脚本的合规约束"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条 30 秒主视频的完整内容活动方案。",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "只使用合成资料可支持的正式能力；说明音乐授权和待制作操作录屏。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "不作涨粉承诺。",
          "source": "用户输入 requirements[1] + M-004"
        },
        {
          "text": "比较包含一次必要返修及复核预留的完整路径，再依据实际预算反馈选择模式；预留不计已发生费用，不要求用尽预算。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "方案截止 2026-10-30T04:00:00+00:00。",
          "source": "用户输入 deadline"
        },
        {
          "text": "任务预算 600 分（模拟工具费用上限），非音乐采购、拍摄或投放预算。",
          "source": "用户输入 budget_cents"
        }
      ],
      "assumptions": [
        {
          "text": "主视频投放在短视频平台（如抖音/视频号类竖屏信息流），竖屏 1080×1920。",
          "basis": "用户未指定平台；M-003 显示该人群为短视频创作者，竖屏为常见形态；如平台不符需调整画幅与时长"
        },
        {
          "text": "音乐《Late Bus》授权在发布日 D 前可以到。",
          "basis": "M-006「预计 2 个工作日」；未到则按制作步骤用无版权替代曲或延后发布"
        },
        {
          "text": "自动卡点操作录屏由产品/运营侧录制帧剪 4.2 正式版本真实操作。",
          "basis": "M-001 能力范围；录屏属于待制作素材，需真实录制，不用包装动画替代"
        },
        {
          "text": "社团招新场景片段取自 M-005 素材包，无需另行拍摄演员。",
          "basis": "M-005 已取得演员授权且含社团招新场景"
        },
        {
          "text": "本活动主视频按 30 秒档制成片。",
          "basis": "30 秒属于 M-001 适用范围所列 15/30/60 秒成片档位，正文未复述；适用范围字段可引用，但正文无对应句子"
        }
      ],
      "suggestions": [
        {
          "text": "采用「用户情境 + 功能演示」混合结构：前段用社团招新片段建立真实场景，中段切到真实录屏展示自动卡点与逐段微调，结尾回到成片。",
          "basis": "M-003 受访者更愿意保留手动调整、对「一键出片」信任度一般，真实录屏比纯情境画面更能建立可信度；M-005 只能表达场景、不能证明能力"
        },
        {
          "text": "字幕仅用于口播文案与免责说明，不使用 AI 字幕翻译作为卖点。",
          "basis": "M-002 其他语言为实验性，按 M-004 不得写成正式能力；本活动用不到翻译"
        },
        {
          "text": "主视频之外最多配 2 条 15 秒竖屏切片（招新现场版 / 录屏拆解版），不新增拍摄。",
          "basis": "复用 M-005 与同一录屏，制作成本低；排期紧张时可只发主视频"
        },
        {
          "text": "文案避免「一键出片」「最强」「保证卡点精准」，改用「自动对齐节拍，逐段微调」。",
          "basis": "M-001 不承诺所有曲风准确；M-004 禁止绝对化表述"
        }
      ],
      "unknowns": [
        {
          "question": "音乐《Late Bus》商用授权能否在发布日 D 前完成？采购费用未在本任务预算内。",
          "impact": "未到手则主视频须改用已授权替代曲重新卡点或延后发布；音乐采购费用需单独估算",
          "blocking": false
