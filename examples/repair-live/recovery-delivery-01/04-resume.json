  "brief": {
    "version": 1,
    "content": {
      "goal": "围绕帧剪「自动卡点」正式能力，为校园社团招新场景准备一份含一条 30 秒主视频的完整内容活动方案，供后续制作与发布；不承诺涨粉、收益或转化。",
      "audience": "18-24 岁大学生（任务已确认）。建议聚焦「正在为社团招新准备招新视频的社团成员与准成员」：依据 M-003 合成调研，受访者最常制作社团活动记录类视频，且更愿意保留手动调整——所以内容应展示“自动卡点 + 逐段微调”的可操作流程，而非“一键出片”。",
      "product_facts": [
        {
          "claim": "帧剪自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点；支持逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主脚本核心演示动作与字幕表述的唯一能力依据"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确；复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "全曲风，尤其复杂变速与弱节拍音乐",
          "use": "作为脚本中“逐段微调”环节与待确认项的依据，避免绝对化表述"
        },
        {
          "claim": "对节奏清晰的流行乐与鼓点，自动卡点识别更稳；选曲因此建议以节奏清晰的流行乐或鼓点为主。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；M-001 材料范围注明对节奏清晰的流行乐与鼓点识别更稳",
          "use": "选曲建议与音乐授权待办说明（M-006《Late Bus》120 BPM）"
        },
        {
          "claim": "校园场景视频素材包覆盖教室、操场、社团招新、宿舍剪辑四个场景，共 12 条 10-20 秒 1080p 片段，仅作情境画面说明使用场景。",
          "material_id": "M-005",
          "quote": "素材包含教室、操场、社团招新、宿舍剪辑四个场景，共 12 条 10-20 秒片段，分辨率 1080p。素材为情境画面，只能说明使用场景，不能单独证明产品功能。",
          "scope": "已取得演员授权，限本题活动使用；不含品牌 Logo 特写",
          "use": "主视频情境画面的可用素材，仅说明使用场景"
        },
        {
          "claim": "品牌表达要求轻快、真实、可操作，不得承诺涨粉、收益或爆款，不得把实验性功能写成正式能力，不得使用“最强”“唯一”等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述",
          "scope": "适用于所有对外传播",
          "use": "脚本措辞、字幕与活动主题的合规基线"
        },
        {
          "claim": "背景音乐《Late Bus》（120 BPM）当前为待获取授权状态，仅可试听，不可直接用于发布。",
          "material_id": "M-006",
          "quote": "当前状态为待获取授权，预计 2 个工作日；未取得授权前不得作为已可用素材写入制作安排。",
          "scope": "商用授权尚未购买；仅可试听",
          "use": "素材表中标注为待获取，并写明未授权时的替代处置"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条 30 秒主视频的完整内容活动方案",
          "source": "任务输入 requirements"
        },
        {
          "text": "只使用合成资料可支持的正式能力",
          "source": "任务输入 requirements"
