  "brief": {
    "version": 1,
    "content": {
      "goal": "以校园社团招新为主题，围绕帧剪「自动卡点」正式能力，为 18-24 岁大学生准备一份含一条 30 秒主视频的短视频推广活动方案，覆盖活动安排、主脚本、素材用途、制作步骤与证据关联。",
      "audience": "18-24 岁在校大学生（用户已确认）；重点面向有社团活动记录需求的社团成员与招新负责人。依据：M-003 合成调研显示该样本最常制作社团活动记录类短视频，且更看重保留手动调整（不可外推至全体大学生）。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐节拍，把用户选中的视频片段对齐到节拍点，并支持逐段微调与一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主视频核心卖点与第 2-3 段画面演示的产品能力依据；也说明 30 秒主视频在正式支持时长内"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上，说明为功能适用范围与限制",
          "use": "脚本字幕与口播中避免绝对化承诺，提示需要人工微调"
        },
        {
          "claim": "对外表达应轻快、真实、可操作，不得承诺涨粉、收益或爆款，不得把实验性功能写成正式能力，不得使用‘最强’‘唯一’等绝对化表述。",
          "material_id": "M-004",
          "quote": "不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "全案文案与脚本的表达约束"
        },
        {
          "claim": "AI 字幕当前正式支持普通话和英语，其他语言为实验性；本次不作为卖点。",
          "material_id": "M-002",
          "quote": "普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "当前正式支持普通话与英语识别；其他语言为实验性",
          "use": "明确本次不使用 AI 字幕作为卖点，避免误用实验性能力"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条 30 秒主视频的完整内容活动方案。",
          "source": "用户输入 requirements"
        },
        {
          "text": "只使用合成资料可支持的正式能力；说明音乐授权和待制作操作录屏；不作涨粉承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不得使用‘最强’‘唯一’等绝对化表述，不得把实验性功能写成正式能力。",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "情境画面只能说明使用场景，不能单独证明产品功能。",
          "source": "M-005 素材登记"
        }
      ],
      "assumptions": [
        {
          "text": "主视频发布平台按短视频平台（如抖音/小红书类竖屏）假设，竖屏 9:16。",
          "basis": "主题为短视频推广且受众为大学生；平台未明确，作为可在方案中调整的建议假设"
        },
        {
          "text": "活动排期以任务截止 2026-10-30 04:00 UTC 为方案准备与核实保存的约束；成片制作与发布另列建议排期。",
          "basis": "任务输入 deadline 与工作知识中方案截止仅约束方案准备及保存"
        }
      ],
      "suggestions": [
        {
          "text": "采用‘用户情境+功能演示’结合的表达：用社团招新片段作为情境，用局部操作录屏演示自动卡点对齐与逐段微调。",
          "basis": "M-003 显示该受众最常做社团活动记录且重视手动调整；M-005 提供校园情境画面；产品能力以 M-001 为依据"
        },
        {
          "text": "主视频结尾给出‘逐段微调’提示，回应该群体对‘一键出片’信任度一般、更愿保留手动调整的倾向。",
          "basis": "M-003 调研片段"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》商用授权是否能在发布前取得（当前仅可试听，预计 2 个工作日）？",
          "impact": "影响主视频背景音乐可用性；未取得前只能作为待获取素材，需准备替代音乐方案",
          "blocking": false
        },
        {
          "question": "操作录屏由谁在哪个版本设备上录制（需 iOS/Android 4.2 及以上）？",
          "impact": "影响自动卡点演示画面的真实性与制作排期",
          "blocking": false
        },
        {
          "question": "具体发布平台与账号矩阵、投放费用与成片制作费用。",
          "impact": "影响内容安排与真实活动预算；任务预算仅为方案准备的模拟工具费用，不代表音乐采购或投放",
          "blocking": false
        }
      ],
