  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」制作一条30秒校园社团招新主题短视频（含配套活动安排），演示自动卡点并保留手动微调，让18-24岁大学生看懂“社团活动记录怎么快速卡上节奏”，不作涨粉承诺。",
      "audience": "18-24岁大学生（用户已确认）。合成调研显示该群体最常制作社团活动记录、学习打卡和旅行 vlog，且多数人愿在30分钟内完成成片、更愿意保留手动调整（M-003，仅代表120人合成样本，不可外推）。据此把受众细化为“需要为社团招新做活动记录视频的学生社团成员/干事”，该细化属建议。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐节拍，把用户选中的视频片段对齐到节拍点，并提供逐段微调与一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主脚本的核心演示点：卡点结果可逐段微调，避免“一键出片”过度承诺"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "iOS/Android 4.2 及以上；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "脚本第3段以“换一段更清晰的鼓点更稳”呈现限制，并在活动说明中注明选曲建议"
        },
        {
          "claim": "AI 字幕正式支持普通话与英语，可批量改样式、一键翻译为英语；其他语言仍为实验性。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "普通话与英语为正式支持；其他语言不计入对外承诺",
          "use": "作为可选辅助说明（招新视频里的社团旁白字幕），仅写正式支持范围，不作主卖点"
        },
        {
          "claim": "校园场景素材包含教室、操场、社团招新、宿舍剪辑四个场景共12条10-20秒1080p片段，已取得演员授权、限本题使用。",
          "material_id": "M-005",
          "quote": "素材包含教室、操场、社团招新、宿舍剪辑四个场景，共 12 条 10-20 秒片段，分辨率 1080p。素材为情境画面，只能说明使用场景，不能单独证明产品功能。",
          "scope": "已取得演员授权，限本题活动使用；不含品牌 Logo 特写",
          "use": "第1、4段情境画面；只表达招新场景，不用于证明卡点能力"
        },
        {
          "claim": "对外表达应轻快、真实、可操作，不得承诺涨粉/收益/爆款，不得把实验性功能写成正式能力，不得使用“最强”“唯一”等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播",
          "use": "全案文案、字幕与活动主题的合规底线；字幕采用可操作动词，不用绝对化词"
        }
      ],
      "creative_requirements": [
        {
          "text": "围绕自动卡点，准备一份含一条30秒主视频的完整内容活动方案",
          "source": "用户输入 requirements"
        },
        {
          "text": "只使用合成资料可支持的正式能力",
          "source": "用户输入 requirements"
        },
        {
          "text": "说明音乐授权和待制作操作录屏",
          "source": "用户输入 requirements"
        },
        {
          "text": "不作涨粉承诺",
          "source": "用户输入 requirements；M-004 品牌规则同向要求"
        },
        {
          "text": "不得使用“最强”“唯一”等绝对化表述，不得把实验性功能写成正式能力",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "情境画面只能说明使用场景，不能单独证明产品功能",
          "source": "M-005 素材登记适用范围"
        }
      ],
      "assumptions": [
        {
          "text": "主视频时长为30秒，按自动卡点支持的15/30/60秒成片规格制作",
          "basis": "用户要求30秒主视频；M-001 支持30秒成片"
        },
        {
          "text": "配乐选用节奏清晰的120 BPM 曲目《Late Bus》作为卡点演示参考",
          "basis": "M-006 记录该曲120 BPM、适合卡点演示；M-001 说明节奏清晰的流行乐与鼓点识别更稳"
        },
        {
          "text": "发布平台以校园社群可分享的竖屏短视频平台为主（如抖音/视频号类），竖屏9:16",
          "basis": "受众为大学生、题材为社团招新的常规传播习惯；属建议性假设，未在资料中确认"
        },
        {
          "text": "活动在方案截止后进入制作与发布，成片发布节点为建议排期，非承诺",
          "basis": "任务截止2026-10-30T04:00Z 仅约束方案准备与保存"
        }
      ],
      "suggestions": [
        {
          "text": "只做一条30秒主视频，不做多平台切片矩阵，把资源集中在卡点演示的说服力上",
          "basis": "用户只要求一条30秒主视频；预算2000分（模拟工具费用）有限，多切片会增加制作与授权依赖"
        },
        {
          "text": "脚本第2段保留“卡完后逐段拖动微调”的细节镜头，而不是只展示一键效果",
          "basis": "M-003 显示受访者对“一键出片”信任度一般、更愿意保留手动调整"
        },
        {
          "text": "字幕用“拖一下、对一下、再导出”这类可操作动词，避免“轻松涨粉”“秒出大片”",
          "basis": "M-004 要求真实、可操作且不作涨粉承诺"
        },
        {
          "text": "备一段替代鼓点作为后备音轨，在《Late Bus》授权未到位时使用",
          "basis": "M-006 授权尚未购买，仅可试听，预计2个工作日；需避免发布前卡在音乐授权上"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》的商用授权由谁购买、预算多少、是否能在发布前拿到（预计2个工作日）",
          "impact": "未授权则第2-3段卡点演示音乐不可用，须换成后备原创/已授权鼓点，成片节奏与镜头切点需重排",
