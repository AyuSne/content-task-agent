  "brief": {
    "version": 1,
    "content": {
      "goal": "用已有校园素材 M-005 剪出一条 30 秒竖屏短视频，演示「帧剪」自动卡点如何把校园片段对齐到音乐节拍并可逐段微调，服务抖音大学生受众。",
      "audience": "抖音上的大学生（用户已确认）。依据：目标平台为抖音、用户明确指定；校园场景素材与操场、社团招新、宿舍剪辑等场景贴合大学生日常，可让受众代入。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主脚本核心能力表述与结尾字幕，作为本次唯一主打卖点"
        },
        {
          "claim": "用户可以逐段微调卡点结果，也可以一键重新卡点。",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上",
          "use": "主脚本中演示“微调”步骤的操作说明与字幕"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "节奏清晰的流行乐与鼓点识别更稳；复杂变速或弱节拍音乐需人工调整",
          "use": "作为口播/字幕的诚实边界提示，避免过度承诺"
        },
        {
          "claim": "自动卡点处理的对象是用户选中的视频片段，成片的 30 秒规格适用于本次任务。",
          "material_id": "M-001",
          "quote": "把用户选中的视频片段对齐到节拍点",
          "scope": "材料范围标注：iOS/Android 4.2 及以上、支持 15/30/60 秒成片",
          "use": "说明演示所用片段可由用户自行选择，并支撑本次 30 秒竖屏规格；规格依据出自材料范围标注而非正文句子"
        }
      ],
      "creative_requirements": [
        {
          "text": "使用已有校园素材 M-005 制作 30 秒竖屏视频",
          "source": "用户输入"
        },
        {
          "text": "突出自动卡点功能",
          "source": "用户输入"
        },
        {
          "text": "不承诺涨粉或收益",
          "source": "用户输入"
        },
        {
          "text": "表达轻快、真实、可操作；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "视频在抖音按 9:16 竖屏、1080p 交付",
          "basis": "用户指定“竖屏视频”与抖音平台；M-005 素材为 1080p"
        },
        {
          "text": "成片使用 30 秒档位的自动卡点",
          "basis": "M-001 范围标注支持 15/30/60 秒成片，用户要求 30 秒"
        },
        {
          "text": "选用节奏清晰的流行乐作为演示曲目，以获得更稳定的卡点效果",
          "basis": "M-001 范围标注指出节奏清晰的流行乐与鼓点识别更稳"
        }
      ],
      "suggestions": [
        {
          "text": "采用功能演示 + 轻情境的表达：开头 3 秒用社团招新片段建立校园代入，随后集中展示自动卡点与逐段微调",
          "basis": "用户要求突出自动卡点；M-005 素材仅为情境画面，不能单独证明功能，功能表述须靠 M-001 支撑"
        },
        {
          "text": "结尾用一句话口播诚实提示“弱节拍或变速音乐需要手动调整”，提升可信度",
          "basis": "M-001 明确不承诺所有曲风都准确；M-004 要求真实、可操作"
        },
        {
          "text": "背景音乐优先在音乐库中选用已获商用授权的曲目；《Late Bus》需先购授权再使用",
          "basis": "M-006 商用授权尚未购买，仅可试听，不可直接用于发布"
