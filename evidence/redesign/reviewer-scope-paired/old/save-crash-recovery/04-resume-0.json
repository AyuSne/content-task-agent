  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」制作一条30秒短视频，面向18-24岁大学生介绍用学习打卡素材快速完成卡点剪辑，演示自动对齐节拍与逐段微调，作为可交给运营继续制作的活动方案。",
      "audience": "18-24岁大学生（用户已确认）。合成调研样本显示他们常做学习打卡类短视频，倾向在30分钟内完成成片，认可自动卡点减少重复操作，但对\"一键出片\"信任度一般、更愿保留手动调整——因此脚本以\"自动卡点+逐段微调\"为主线。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐节拍，把选中视频片段对齐到节拍点；用户可逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持15/30/60秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本核心卖点：第2段自动对齐节拍演示、第3段逐段微调演示"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "所有使用场景",
          "use": "脚本对能力的边界表述：选节奏清晰曲目，字幕提示可手动微调"
        },
        {
          "claim": "品牌表达要求轻快、真实、可操作，不承诺涨粉/收益/爆款，不把实验性功能写成正式能力，不用“最强”“唯一”等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "全文表达与字幕口径的合规约束"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入"
        },
        {
          "text": "一条30秒主视频，演示自动对齐节拍和逐段微调。",
          "source": "用户输入"
        },
        {
          "text": "平台和发布排期可提出建议，不作为关键阻塞。",
          "source": "用户输入"
        },
        {
          "text": "不得使用“最强”“唯一”等绝对化表述，不得把实验性功能写成正式能力。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "目标平台可提议为抖音为主、视频号/B站为次，竖屏 9:16，30 秒单条主视频构成完整活动。",
          "basis": "用户允许平台建议；M-003 样本为校园短视频创作习惯，未指定平台"
        },
        {
          "text": "配乐选用节奏清晰的 120 BPM 曲目以便卡点演示效果稳定。",
          "basis": "M-001 对节奏清晰曲目识别更稳；M-006《Late Bus》120 BPM"
        },
        {
          "text": "演示录屏基于帧剪 iOS/Android 4.2 及以上版本录制，成片时长30秒。",
          "basis": "M-001 适用范围"
        }
      ],
      "suggestions": [
        {
          "text": "脚本结构：0-3s 学习打卡成片钩子 → 4-15s 自动卡点对齐 → 16-24s 逐段微调 → 25-30s 成片与行动提示，避免“一键出片”式夸大。",
          "basis": "M-003 受访者认可自动卡点但更愿保留手动调整；用户要求演示两项能力"
        },
        {
          "text": "情境画面统一取自校园场景素材包中的教室/宿舍剪辑场景，产品能力由录屏段落承载。",
          "basis": "M-005 素材为情境画面，不能单独证明功能；M-003 学习打卡为主要创作类型"
        },
        {
          "text": "字幕避免“轻松涨粉”“效率翻倍”等表述，改为可操作描述（如“逐段拖到节拍点”）。",
          "basis": "M-004 品牌表达规则"
        }
      ],
      "unknowns": [
        {
          "question": "背景音乐《Late Bus》商用授权尚未购买，是否由运营按 2 个工作日流程采购，或改用其他已授权曲目？",
          "impact": "影响主脚本配乐与卡点演示节拍的最终版本；未落实则需替代曲目",
          "blocking": false
        },
        {
          "question": "操作录屏由谁在何版本设备上录制、是否需要露出手指操作/界面细节？",
          "impact": "影响录屏素材制作排期与剪辑素材精细度",
          "blocking": false
        },
        {
          "question": "音乐采购、录屏制作与投放费用未给出，需单列待估。",
          "impact": "真实活动成本未知，本方案不承诺金额；任务预算仅为方案准备模拟工具费用",
          "blocking": false
        }
      ],
