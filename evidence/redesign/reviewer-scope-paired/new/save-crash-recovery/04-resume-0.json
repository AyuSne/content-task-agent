    "content": {
      "goal": "用一条30秒短视频向18-24岁大学生演示帧剪「自动卡点＋逐段微调」，讲清学习打卡视频的节拍剪辑怎么一步完成，引导他们下载尝试并保留手动调整的习惯",
      "audience": "18-24岁大学生（用户已确认）。合成调研 M-003 显示该样本中最常做社团活动记录、学习打卡和旅行 vlog，超半数会在30分钟内完成一条成片，并更愿意保留手动调整；仅代表该120人合成样本",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主视频第2段演示与字幕的正式能力主张"
        },
        {
          "claim": "对齐后可逐段微调，也可一键重新卡点",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主视频第3段「逐段微调」演示"
        },
        {
          "claim": "复杂变速或弱节拍音乐需要人工调整，不承诺所有曲风准确",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "自动卡点能力的边界说明",
          "use": "脚本与文案避免绝对化表述；成片限用节奏清晰的流行乐"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条30秒主视频，演示自动对齐节拍和逐段微调",
