  "brief": {
    "version": 1,
    "input_version": 1,
    "content": {
      "goal": "用一条15秒竖屏短视频，向18-24岁大学生演示帧剪社团招新合辑的自动卡点与逐段手动微调，并邀请按需尝试。",
      "audience": "18-24岁大学生（用户确认）；合成调研显示该群体常做社团活动记录，倾向保留手动调整，可作内容取舍依据，但不外推到全体大学生。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐的节拍，把选中的视频片段对齐到节拍点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主视频第2段操作录屏与字幕的核心卖点"
        },
        {
          "claim": "卡点后用户可以逐段微调，也可以一键重新卡点。",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片",
          "use": "主视频第3段逐段手动微调演示与结尾邀请"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "iOS/Android 4.2 及以上；节奏清晰度影响识别效果",
          "use": "限制表达边界：字幕写“选节奏清晰的曲子”，不作普遍准确承诺"
        },
        {
          "claim": "品牌表达应轻快、真实、可操作，不承诺涨粉、收益或爆款，不使用绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "文案与口播语气、禁语检查"
        }
      ],
      "creative_requirements": [
        {
          "text": "仅一条15秒竖屏主视频，突出自动对齐节拍和逐段手动微调，结尾邀请按需尝试。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述。",
          "source": "材料 M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "成片时长15秒，属于 M-001 适用范围中支持的15/30/60秒成片长度。",
          "basis": "用户要求15秒；M-001 支持15秒成片"
        },
        {
          "text": "画面使用校园社团招新情境（排练、招新摊位、成片展示），只承担场景表达，产品能力由操作录屏与字幕承担。",
          "basis": "M-005 素材包含社团招新场景，且明确情境画面不能单独证明产品功能"
        },
        {
          "text": "演示曲目使用节奏清晰的鼓点/流行乐，符合 M-001 识别更稳的条件。",
          "basis": "M-001 适用范围说明"
        }
      ],
      "suggestions": [
        {
          "text": "采用“情境引入—自动卡点—逐段微调—邀请尝试”的四段节奏，前3秒交代社团招新语境，中段录屏占主要时长，不添加未要求的字幕翻译等附加卖点。",
          "basis": "用户要求突出两项能力且仅15秒；M-003 显示该群体看重手动调整空间"
        },
        {
          "text": "背景音乐优先使用原创鼓点或已获授权的节奏清晰曲目；若采用 M-006《Late Bus》，须先完成商用授权再入成片。",
          "basis": "M-006 授权未购买，仅可试听"
        },
        {
          "text": "建议发布平台为校园社群与短视频平台竖屏投放，发布节点由运营在成片审核后确定。",
          "basis": "用户 allow 平台与排期作为建议；竖屏格式要求"
        }
      ],
      "unknowns": [
        {
          "question": "成片与投放的真实制作费用（音乐采购、录屏制作、投放）未给出。",
          "impact": "仅影响后续制作排期与资源，本方案不据此承诺采购；不影响本方案准备与保存。",
          "blocking": false
        },
        {
          "question": "背景音乐最终选用原创鼓点还是 M-006《Late Bus》。",
          "impact": "影响第1段起音与卡点演示素材；未授权前不得入成片，可先用原创鼓点替代。",
          "blocking": false
        }
      ],
