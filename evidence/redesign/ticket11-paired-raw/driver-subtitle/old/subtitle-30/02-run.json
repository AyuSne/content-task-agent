  "brief": {
    "version": 1,
    "content": {
      "goal": "用一条 30 秒短视频演示「帧剪」把英语口播人声转成可编辑字幕并人工校对的正式能力，为运营团队提供可直接继续制作的内容方案。",
      "audience": "任务已确认受众为 18 岁以上英语口播视频创作者（用户输入）。可用于该受众的依据有限：M-003 的调研样本是 18-24 岁大学生、更常做社团记录/学习打卡/旅行 vlog，且报告限定不可外推到全体人群，因此仅作为「希望保留手动调整、不愿盲信一键出片」这类心态的参考，不直接用来说明英语口播创作者的行为习惯。",
      "product_facts": [
        {
          "claim": "帧剪的 AI 字幕可把视频中的人声转成可编辑字幕，并支持批量修改字幕样式。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。",
          "scope": "当前正式支持普通话与英语识别；其他语言为实验性，不计入对外承诺。",
          "use": "主脚本核心卖点：英语口播人声→可编辑字幕；演示中展示逐句修改与批量改样式。"
        },
        {
          "claim": "英语是帧剪 AI 字幕正式支持的识别语言之一。",
          "material_id": "M-002",
          "quote": "普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "正式支持语言为普通话与英语；粤语、日语等为小范围测试、质量不稳定。",
          "use": "支撑「英语口播」这一题目场景；同时作为排除任意语言翻译宣称的依据。"
        },
        {
          "claim": "一键翻译能力的对外范围限于翻译为英语。",
          "material_id": "M-002",
          "quote": "支持批量改样式和一键翻译为英语",
          "scope": "该表述只覆盖“翻译为英语”这一个方向，不能推广为“翻译为任意语言”。",
          "use": "约束脚本措辞：不得宣称可翻译为任意语言；本条功能不作为英语口播视频的主卖点。"
        },
        {
          "claim": "自动识别结果需要人工校对，不能承诺完全准确。",
          "material_id": "M-002",
          "quote": "识别质量不稳定",
          "scope": "该片段原文针对粤语、日语等测试语言的质量描述；因此本方案只主张“生成后可编辑、支持人工校对”，不主张识别百分百准确。",
          "use": "脚本中保留“机器出稿 + 人工校对”的两步表述，避免准确率承诺。"
        }
      ],
      "creative_requirements": [
        {
          "text": "仅一条 30 秒主视频。",
          "source": "用户输入 requirements"
        },
        {
          "text": "核心为英语语音转可编辑字幕及人工校对。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不把一键翻译成英语写成翻译为任意语言；不宣称识别百分百准确。",
          "source": "用户输入 requirements"
        },
        {
          "text": "产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "允许把缺少的画面、操作录屏和原创配乐列为待制作，写清责任人、位置和权属核对；不可冒充现成素材。",
          "source": "用户输入 requirements"
        },
        {
          "text": "平台和发布排期可以提出建议，不必把可建议项当成关键阻塞。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述。",
          "source": "M-004 品牌表达规则"
        },
        {
          "text": "表达应轻快、真实、可操作。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "主视频按竖屏 9:16、口播记录类场景呈现，以便投放短视频平台。",
          "basis": "用户只确认“英语口播创作者”与“30 秒主视频”，未指定画幅；这是可调创作假设，不改变目标与硬约束。"
        },
        {
          "text": "演示用的英语口播原片由运营自行拍摄/录制，用于展示真实转写与校对过程。",
          "basis": "用户明确允许把缺少的画面与操作录屏列为待制作。"
        },
        {
          "text": "原创配乐由运营制作或采购，音量为轻量背景，不干扰口播声音。",
          "basis": "用户允许原创配乐列为待制作；口播字幕演示需保证人声清晰。"
        }
      ],
      "suggestions": [
        {
          "text": "采用“情境 + 功能演示”混合结构：前 5 秒口播创作者真实困境，中段录屏演示英语人声出可编辑字幕、逐句改动，结尾用人工校对提示收束。",
          "basis": "用户要求以功能为核心且只有一个 30 秒主视频；M-004 要求可操作、真实；M-003 显示用户更愿保留手动调整，把“人工校对”作为卖点比“一键出片”更可信。"
        },
        {
          "text": "镜头里同时呈现「机器出稿」与「手动改词」两步，明确字幕可编辑这件事，而不是只展示生成速度。",
          "basis": "M-002 支持的正式能力是“转成可编辑字幕”，可编辑性与人工校对正是可被证据支撑的部分。"
        },
        {
          "text": "建议主投放平台为抖音/小红书等竖屏短视频平台，发布节点建议在成片审核通过后的次个工作日，与方案截止脱钩。",
          "basis": "用户允许平台与排期作为建议；方案截止只约束方案准备与保存。"
        },
        {
          "text": "不使用 M-005 校园素材包作为本片主体画面，仅在有需要时借用少量场景镜头；其定位是情境画面，不能证明产品功能。",
          "basis": "M-005 明确“只能说明使用场景，不能单独证明产品功能”，且受众与校园场景不完全一致。"
        }
      ],
      "unknowns": [
