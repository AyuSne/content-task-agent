  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一份可交付运营继续制作的短视频推广活动方案：以一条 30 秒主视频演示自动对齐节拍与逐段微调，帮助 18-24 岁大学生在学习打卡类短片中减少重复对齐操作。",
      "audience": "18-24 岁大学生（用户指定）。在方案中将其具体化为\"有学习打卡 / 社团活动类短片的在校大学生\"，依据 M-003：合成调研样本中最常制作类型含学习打卡与社团活动记录，且过半受访者在 30 分钟内完成一条成片、认可自动卡点能减少重复操作；该依据仅代表该 120 人合成样本，不外推为全体大学生。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本第 2-3 段的演示依据；作为对外表述的正式能力边界"
        },
        {
          "claim": "用户可以对已对齐的片段逐段微调，也可以一键重新卡点。",
          "material_id": "M-001",
          "quote": "用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上自动卡点功能内",
          "use": "主脚本第 4 段的演示依据，对应创作要求中的\"逐段微调\""
        },
        {
          "claim": "自动卡点不保证对所有曲风准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "全曲风；复杂变速与弱节拍音乐尤甚",
          "use": "脚本选曲与字幕表述的约束：选用节奏清晰的鼓点音乐，并保留\"可人工调整\"的真实说明，避免绝对化承诺"
        },
        {
          "claim": "对外表达应轻快、真实、可操作，不得承诺涨粉、收益或爆款，不得把实验性功能写成正式能力，不得使用\"最强\"\"唯一\"等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "全案文案、字幕与运营话术的合规底线自检"
        },
        {
          "claim": "校园场景素材包内含教室、操场、社团招新、宿舍剪辑四个场景共 12 条 10-20 秒 1080p 片段，已取得演员授权，限本题活动使用，不含品牌 Logo 特写。",
          "material_id": "M-005",
          "quote": "素材包含教室、操场、社团招新、宿舍剪辑四个场景，共 12 条 10-20 秒片段，分辨率 1080p。素材为情境画面，只能说明使用场景，不能单独证明产品功能。",
          "scope": "已取得演员授权，限本题活动使用；不含品牌 Logo 特写",
          "use": "作为情境画面素材用于开场与结尾；明确只表达场景，不作为产品能力证明"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入（requirements 第 1 条）"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入（requirements 第 2 条）"
        },
        {
          "text": "一条 30 秒主视频，演示自动对齐节拍和逐段微调。",
          "source": "用户输入（requirements 第 3 条）"
        },
        {
          "text": "平台和发布排期可以提出建议，不必把可建议项当成关键阻塞。",
          "source": "用户输入（requirements 第 2 条）"
        },
        {
          "text": "表达轻快、真实、可操作；不用绝对化表述，不把实验性能力写成正式能力。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "主视频为竖屏 9:16、1080×1920，适合短视频平台信息流观看。",
          "basis": "18-24 岁大学生的短视频消费场景为手机竖屏；属可调整的制作假设，不涉及产品能力"
        },
        {
          "text": "本次以单条 30 秒主视频为核心，配套 1 条 15 秒切片用于二次触达。",
          "basis": "M-001 说明成片支持 15/30/60 秒，15 秒切片可直接复用主视频素材与结论；数量可根据运营人力调整"
        },
        {
          "text": "演示使用一段节奏清晰的鼓点流行乐，以使自动卡点表现稳定。",
          "basis": "M-001 指出节奏清晰的流行乐与鼓点识别更稳"
        }
      ],
      "suggestions": [
        {
          "text": "主视频采用\"用户情境 + 功能演示\"混合结构：前 5 秒用学习打卡情境切入，中间 18 秒录屏演示自动卡点与逐段微调，结尾 7 秒回到情境画面收束。",
          "basis": "M-003 显示受访者对\"一键出片\"信任度一般、更愿意保留手动调整，录屏演示逐段微调比纯情境画面更能建立真实感；情境画面仅表场景（M-005 范围限定）"
        },
        {
          "text": "字幕中明示\"节奏清晰的曲目更稳，复杂曲目仍需手动调整\"，把能力边界前置而非回避。",
          "basis": "M-001 的范围限定 + M-004 的真实表达要求"
        },
        {
          "text": "首发建议抖音，次发视频号 / 小红书，发布节点定在方案交付后的校园学习打卡内容活跃期。",
          "basis": "平台与档期为可建议项（用户第 2 条），不构成阻塞"
        },
        {
          "text": "不使用 AI 字幕的翻译能力作为卖点，本片仅用普通话字幕。",
          "basis": "M-002 中非普通话/英语为实验性能力，M-004 禁止把实验性功能写成正式能力；且本片主题为卡点而非字幕"
        }
