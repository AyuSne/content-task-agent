  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一条30秒短视频的完整推广活动方案，面向18-24岁大学生，以“学习打卡”场景演示自动对齐节拍与逐段微调，供运营继续制作到发布。",
      "audience": "18-24岁大学生（用户已确认）。合成调研显示该群体最常制作社团活动记录、学习打卡和旅行 vlog，过半受访者在30分钟内完成成片，倾向保留手动调整；据此把学习打卡作为主场景，并保留“逐段微调”作为可信卖点。范围仅代表该合成样本。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点；用户可逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本核心演示段：自动卡点+逐段微调的画面与字幕表达"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上：4.2 及以上版本",
          "use": "脚本中“调一下更顺”的表述依据，避免绝对化承诺"
        },
        {
          "claim": "AI 字幕正式支持普通话与英语，可批量改样式并一键翻译为英语；粤语、日语等仍在小范围测试。",
          "material_id": "M-002",
          "quote": "普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "当前版本正式支持范围",
          "use": "主脚本若使用字幕，仅限普通话，且不作为本次主打卖点"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "方案交给运营继续制作，允许把缺少的画面、操作录屏和原创配乐列为待制作，写清责任人、位置和权属核对；不可冒充现成素材。",
          "source": "用户输入 requirements"
        },
        {
          "text": "一条30秒主视频，演示自动对齐节拍和逐段微调。",
          "source": "用户输入 requirements"
        },
        {
          "text": "平台和发布排期可以提出建议，不视为关键阻塞。",
          "source": "用户输入 requirements"
        },
        {
          "text": "表达应轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "主视频发布平台建议为校园受众常用的竖屏短视频平台（抖音/视频号/小红书），最终投放平台由运营按账号矩阵决定。",
          "basis": "用户允许平台作为建议项；M-003 显示该人群以短视频形式记录学习打卡"
        },
        {
          "text": "成片按 9:16 竖屏、30 秒、1080p 制作，与素材包现有规格一致。",
          "basis": "M-001 支持 30 秒成片；M-005 素材为 1080p"
        },
        {
          "text": "配乐优先沿用待授权的《Late Bus》（120 BPM）；若授权未到位，改用平台内置可商用曲库中节奏清晰的曲目重做卡点。",
          "basis": "M-006 显示商用授权未购买、仅可试听；M-001 对节奏清晰的流行乐识别更稳"
        }
      ],
      "suggestions": [
        {
          "text": "用“学习打卡”作为单一主场景，把30秒全部给“选片段—自动卡点—逐段微调”一条操作线，避免堆卖点。",
          "basis": "M-003：学习打卡是高频类型且过半用户想30分钟内出片；M-001 明确该功能可逐段微调"
        },
        {
          "text": "画面用屏幕录制真实操作界面展示自动卡点与微调结果，情境画面只承担“学习打卡”场景叙事。",
          "basis": "M-005 仅为情境画面，不能单独证明功能；M-001 为能力依据"
        },
        {
          "text": "结尾用“逐段微调，卡点顺手就调”这类可操作表述，不写“最准”“一键出大片”等绝对化或夸大承诺。",
          "basis": "M-004 禁止绝对化表述；M-001 说明复杂音乐仍需人工调整"
        },
        {
          "text": "建议发布节奏：先发这条30秒主视频，后续如需切片可在同一素材基础上衍生，是否追加由运营按目标判断。",
          "basis": "用户只要求一条主视频；额外内容需说明收益与制作依赖"
        }
      ],
      "unknowns": [
        {
          "question": "《Late Bus》商用授权能否在制作节点前取得（预计2个工作日）？",
          "impact": "若不能取得，需改用平台可商用曲库曲目并重新验证卡点效果，可能顺延1天拍摄/录屏",
          "blocking": false
        },
        {
          "question": "具体投放平台与账号、发布日D的锚点日期",
          "impact": "影响画幅比例、时长微调与排期表落地；方案按竖屏30秒与建议排期给出",
          "blocking": false
        },
        {
          "question": "真实活动制作与投放费用（录音/录屏、音乐采购、投放）",
          "impact": "任务 2000 分为方案准备模拟工具费用，不构成制作与采买预算；需运营另行申请",
          "blocking": false
        },
        {
          "question": "录屏使用的测试账号与机型（需 iOS/Android 4.2 及以上）",
          "impact": "影响录屏环境与操作路径一致性；若无4.2以上机型需安排升级",
          "blocking": false
        }
      ],
