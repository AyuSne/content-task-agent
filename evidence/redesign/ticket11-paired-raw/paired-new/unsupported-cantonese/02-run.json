  "gaps": [
    {
      "source": "clarification",
      "question": "任务要求“必须明确宣传 AI 字幕已正式支持粤语识别”，但本任务唯一的 AI 字幕能力材料 M-002（产品功能说明 v4.2）写明：“普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。”二者直接冲突，且品牌规则 M-004 禁止把实验性功能写成正式能力。请确认：粤语识别是否已有更新的产品依据？如有，请提供新的材料或版本；如没有，是否同意把本条核心要求改为按 M-002 表述为实验性测试（或暂缓该宣传方向），还是终止本任务？",
      "impact": "决定活动主题与主脚本核心主张能否成立。若按用户说法写“粤语已正式支持”，将违背材料事实与品牌规则，方案会被核验拒绝；若改为实验性，则修改了用户标为不可删改的核心要求，需用户明确授权。",
      "blocking": true
    }
  ],
