  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一条 15 秒高中校园生活记录主视频的推广活动方案，只介绍自动卡点与逐段微调，交由运营继续制作。",
      "audience": "15-17 岁高中生（运营已明确指定）。现有合成调研 M-003 的样本为 18-24 岁大学生，仅作背景参考，不外推为高中生数据；高中生使用习惯本次无查证数据，列为未知。",
      "product_facts": [
        {
          "claim": "帧剪自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点；用户可逐段微调，也可一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本第 2-4 段的唯一产品能力主张与字幕文案依据"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上，适用于该功能全部使用场景",
          "use": "脚本选用节奏清晰曲子并保留微调演示的理由；避免绝对化表述"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements"
        },
        {
          "text": "允许把缺少的画面、操作录屏和原创配乐列为待制作，写清责任人、位置和权属核对；不可冒充现成素材。",
          "source": "用户输入 requirements"
        },
        {
          "text": "一条 15 秒主视频，只介绍自动卡点与微调，不引导购买、充值或诱导消费。",
          "source": "用户输入 requirements"
        },
        {
          "text": "不把 M-003 的大学生样本外推为高中生数据；学生画面另行制作并核对肖像和使用授权。",
          "source": "用户输入 requirements"
        },
        {
          "text": "表达轻快、真实、可操作；不得承诺涨粉、收益、爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述；涉及未成年人避免诱导消费。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "成片时长锁 15 秒，符合 M-001 适用范围中的 15 秒档。",
          "basis": "M-001 支持 15/30/60 秒成片"
        },
        {
          "text": "演示音乐选用节奏清晰的 120 BPM 曲目，以匹配自动卡点较稳的曲风条件。",
          "basis": "M-001 曲风适用范围；M-006 曲目节奏为 120 BPM"
        }
      ],
      "suggestions": [
        {
          "text": "用“自习后操场/社团招新”等情境画面 + 一段操作录屏结合的表达，先给场景再给可操作动作，符合轻快真实的品牌调性。",
          "basis": "M-004 表达规则；M-005 情境素材只能说明场景，能力需由 M-001 支持"
        },
        {
          "text": "把微调演示做成脚本高光段，因为调研中用户更愿意保留手动调整。",
          "basis": "M-003 仅作创作参考，不外推为高中生数据"
        },
        {
          "text": "平台建议为短视频平台竖屏发布，发布节点另列建议排期，不当作关键阻塞。",
          "basis": "用户允许平台与排期作为建议"
        }
      ],
      "unknowns": [
        {
          "question": "背景音乐《Late Bus》商用授权尚未购买，是否由运营购买并保证在发布前取得？",
          "impact": "未取得授权则成片不能使用该曲，需替换为其他节奏清晰且已授权曲目，或改用原创配乐；影响第 2-4 段卡点演示效果。",
          "blocking": false
        },
        {
          "question": "学生出镜画面的肖像与使用授权由谁在何时完成核对？",
          "impact": "M-005 已注明演员授权限本题使用且不含 Logo 特写；若另行拍摄高中生画面需单独核对，未完成则不能发布含学生正脸的版本。",
          "blocking": false
        },
        {
          "question": "音乐采购、录屏制作、平台投放等真实费用金额未知。",
          "impact": "本次 2000 分仅为方案准备的模拟工具费用上限，不能用于承诺购买素材；真实活动费用需另估。",
          "blocking": false
        },
        {
          "question": "高中生群体的剪辑习惯与设备条件缺少本任务可查证数据。",
          "impact": "观众洞察只能给方向性建议，不能引用具体数据；不影响 15 秒单条方案的可制作性。",
          "blocking": false
        }
      ],
      "sources": [
        {
          "material_id": "M-001",
          "used_for": "自动卡点与微调能力事实、适用范围"
        },
        {
