  "brief": {
    "version": 1,
    "input_version": 1,
    "content": {
      "goal": "为「帧剪」周末旅行记录剪辑教程准备一份可交运营继续制作的60秒竖屏主视频活动方案：演示自动卡点后逐段微调，再为普通话口播制作可编辑字幕。",
      "audience": "25-40岁成年旅行爱好者（用户任务输入明确指定）。说明：本任务材料中的受众调研 M-003 仅覆盖18-24岁大学生合成样本，不用于描述该受众的创作习惯或行为数据。",
      "product_facts": [
        {
          "claim": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点；用户可以逐段微调，也可以一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本第3-5段的核心演示与口播主张，以及活动主题表述"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "iOS/Android 4.2 及以上；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "脚本第4段微调环节的口播限定语，避免把自动卡点写成万能"
        },
        {
          "claim": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式；普通话与英语为正式支持语言。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "当前正式支持普通话与英语识别；其他语言为实验性，不计入对外承诺",
          "use": "主脚本第6段字幕演示；不提及粤语、日语等实验性语言，也不提翻译功能"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；缺少的画面、操作录屏和原创配乐可列为待制作，写清责任人、位置和权属核对，不可冒充现成素材。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "平台和发布排期可以提出建议，不必把可建议项当成关键阻塞。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条60秒竖屏主视频，演示自动卡点后微调，再为普通话口播制作可编辑字幕。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "不把大学生合成调研外推为25-40岁受众的事实。",
          "source": "用户输入 requirements[2]；M-003 适用范围"
        },
        {
          "text": "旅行画面可由制作人员后续自行拍摄并核对权属。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "表达应轻快、真实、可操作；不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用“最强”“唯一”等绝对化表述。",
          "source": "M-004 品牌表达规则"
        }
      ],
      "assumptions": [
        {
          "text": "主视频成片时长取60秒，属于 M-001 适用范围提到的受支持成片规格。",
          "basis": "用户要求“一条60秒竖屏主视频”；M-001 适用范围“支持 15/30/60 秒成片”"
        },
        {
          "text": "演示音乐先用节奏清晰、鼓点明显的曲目，以便自动卡点更稳定。",
          "basis": "M-001 适用范围“对节奏清晰的流行乐与鼓点识别更稳”"
        },
        {
          "text": "普通话口播由运营或出镜同事录制后作为字幕识别输入。",
          "basis": "M-002 正式支持普通话识别；用户要求为普通话口播制作字幕"
        }
      ],
      "suggestions": [
        {
          "text": "主视频建议放在抖音/小红书竖屏短视频渠道首发的同一版本，作为教程型内容；平台为建议，最终由运营按账号情况确认。",
          "basis": "用户未指定平台，允许建议；主题为教程型内容，竖屏60秒适配短视频平台常规形态"
        },
        {
          "text": "脚本结构采用“旅行片段开场—自动卡点演示—逐段微调—普通话口播字幕—收尾引导试剪”，先给操作后给结论，符合品牌“可操作”的表达基调。",
          "basis": "M-004 表达规则；用户要求演示自动卡点后微调与可编辑字幕"
        },
        {
          "text": "配乐不使用未取得授权的《Late Bus》，改为待制作的原创鼓点或另行取得授权的节奏清晰曲目。",
          "basis": "M-006 商用授权尚未购买，仅可试听"
        },
        {
          "text": "活动可只以这一条主视频构成完整方案，不额外添加切片或卖点，避免增加未要求的制作依赖。",
          "basis": "用户仅要求一条60秒竖屏主视频；campaign-creation 聚焦范围"
        }
      ],
      "unknowns": [
