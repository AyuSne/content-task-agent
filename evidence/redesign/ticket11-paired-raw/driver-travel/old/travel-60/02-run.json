  "brief": {
    "version": 1,
    "content": {
      "goal": "为「帧剪」准备一条 60 秒竖屏旅行记录剪辑教程短视频的完整内容活动方案，演示自动卡点后逐段微调、再为普通话口播生成可编辑字幕，方案交由运营继续制作。",
      "audience": "25-40 岁成年旅行爱好者（用户已确认）。建议聚焦“会拍旅行素材但剪辑时间有限、愿意在自动结果上手动微调”的周末短途旅行者：理由来自任务输入对该受众的确认，以及 M-003 中“对‘一键出片’信任度一般、更愿保留手动调整”的创作态度倾向——该调研样本为 18-24 岁大学生，仅作创作态度参考，不作为该受众的人群事实。",
      "product_facts": [
        {
          "claim": "帧剪的自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点，并支持逐段微调和一键重新卡点。",
          "material_id": "M-001",
          "quote": "自动卡点会分析所选音乐的节拍，把用户选中的视频片段对齐到节拍点。用户可以逐段微调，也可以一键重新卡点。",
          "scope": "iOS/Android 4.2 及以上；支持 15/30/60 秒成片；对节奏清晰的流行乐与鼓点识别更稳",
          "use": "主脚本第 2-3 段：演示自动卡点生成节奏切分，再做逐段微调与一键重新卡点"
        },
        {
          "claim": "自动卡点不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "material_id": "M-001",
          "quote": "该功能不承诺对所有曲风都准确，复杂变速或弱节拍音乐需要人工调整。",
          "scope": "同上，自动卡点能力说明整体适用范围",
          "use": "主脚本台词与字幕的边界表述，并在方案待确认项中说明选曲风险"
        },
        {
          "claim": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语；普通话与英语为正式支持语言。",
          "material_id": "M-002",
          "quote": "AI 字幕可把视频中的人声转成可编辑字幕，支持批量改样式和一键翻译为英语。普通话与英语为正式支持语言；粤语、日语等仍在小范围测试，识别质量不稳定。",
          "scope": "当前正式支持普通话与英语识别；其他语言为实验性，不计入对外承诺",
          "use": "主脚本第 4-5 段：为普通话口播素材生成字幕后改样式与错字，本次只主张普通话"
        },
        {
          "claim": "品牌表达应轻快、真实、可操作，不得承诺涨粉、收益或爆款，不得把实验性功能写成正式能力，不得使用“最强”“唯一”等绝对化表述。",
          "material_id": "M-004",
          "quote": "表达应轻快、真实、可操作。不得承诺涨粉、收益或爆款；不得把实验性功能写成正式能力；不得使用‘最强’‘唯一’等绝对化表述；涉及未成年人时避免诱导消费。",
          "scope": "适用于所有对外传播；与用户明确要求冲突时交回用户决定",
          "use": "全案表达与台词审查底线，核验时逐条对照"
        }
      ],
      "creative_requirements": [
        {
          "text": "准备完整内容活动方案，产品主张只用材料支持的正式能力；不作涨粉、收益或爆款承诺。",
          "source": "用户输入 requirements[0]"
        },
        {
          "text": "方案交给运营继续制作；允许把缺少的画面、操作录屏和原创配乐列为待制作，写清责任人、位置和权属核对；不可冒充现成素材。",
          "source": "用户输入 requirements[1]"
        },
        {
          "text": "一条 60 秒竖屏主视频，演示自动卡点后微调，再为普通话口播制作可编辑字幕。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "不把大学生合成调研外推为该受众事实；旅行画面可由制作人员后续自行拍摄并核对权属。",
          "source": "用户输入 requirements[2]"
        },
        {
          "text": "平台和发布排期可提出建议，不把可建议项当成关键阻塞。",
          "source": "用户输入 requirements[1]"
        }
      ],
      "assumptions": [
        {
          "text": "主视频为竖屏 9:16、总长 60 秒，属于自动卡点正式支持的 15/30/60 秒成片规格范围内。",
          "basis": "用户输入要求 60 秒竖屏；M-001 写明支持 60 秒成片"
        },
        {
          "text": "旅行画面与操作录屏由运营制作人员在方案确认后自行拍摄与录制，权属由制作方核对。",
          "basis": "用户输入 requirements[2] 明确允许并授权后续拍摄"
        },
        {
          "text": "本次字幕演示只覆盖普通话口播，不展示其他语言识别或英语翻译。",
          "basis": "用户输入要求“为普通话口播制作可编辑字幕”；M-002 支持普通话正式能力，其他语言为实验性"
        }
      ],
      "suggestions": [
        {
          "text": "采用“教程”方向：以周末旅行素材为主线，把自动卡点→逐段微调→普通话口播字幕串成可跟做的三步，结尾一句行动引导用户在自己的素材上试。",
          "basis": "用户要求的是教程式演示；M-003 显示用户对“一键出片”信任度一般、更愿保留手动调整，恰好匹配“自动后微调”的叙事重点（该调研样本为 18-24 岁大学生，仅作创作态度参考）"
        },
        {
          "text": "建议首选发布平台为竖屏短视频平台（如抖音/小红书视频号类），单条发布，成片后按平台竖屏规格适配；发布节点建议为成片验收后次日。",
          "basis": "受众为 25-40 岁成年旅行爱好者，竖屏短视频是其常见浏览形态；属于可建议项，不阻塞方案"
        },
        {
          "text": "配乐优先选用节奏清晰的 120 BPM 流行乐或鼓点曲目，以贴合自动卡点的稳定曲风范围；《Late Bus》可作为候选，但须先完成商用授权。",
          "basis": "M-001 说明节奏清晰的流行乐与鼓点识别更稳；M-006 记 120 BPM 且适合卡点演示，但商用授权尚未购买"
        },
        {
          "text": "台词中明确“逐段可调”，不宣称全自动完美对齐，以呼应品牌“真实、可操作”的表述规则。",
          "basis": "M-001 说明不承诺对所有曲风都准确；M-004 要求真实、可操作且禁止绝对化表述"
        }
      ],
      "unknowns": [
        {
          "question": "旅行画面、操作录屏与普通话口播的拍摄/录制工作是否由运营团队在 2026-10-30 方案截止后自行执行？",
          "impact": "影响素材状态标注（待制作）与建议排期锚点；不影响方案准备与保存",
